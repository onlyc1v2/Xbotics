<mujoco model="anymal_c scene terrain">
  <include file="anymal_c.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <statistic center="0 0 .3" extent="1.2"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    
    <!-- 地形纹理 -->
    <texture type="2d" name="terrain_texture" builtin="checker" mark="edge" rgb1="0.3 0.4 0.5" rgb2="0.2 0.3 0.4"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="terrain_mat" texture="terrain_texture" texuniform="true" texrepeat="10 10" reflectance="0.1"/>
    
    <!-- 高度字段（网格地形）- 使用噪声纹理生成 -->
    <hfield name="terrain_hfield" size="20 20 2 0.1" nrow="100" ncol="100"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    
    <!-- 高度场地形 -->
    <geom name="ground" hfield="terrain_hfield" material="terrain_mat" type="hfield"/>
    
    <!-- 可选：添加一些障碍物 -->
    <!-- 小石块障碍 -->
    <!-- 
    <body name="obstacle_1" pos="5 5 1.5">
      <geom type="sphere" size="0.3" material="terrain_mat"/>
    </body>
    <body name="obstacle_2" pos="-5 5 1.5">
      <geom type="sphere" size="0.3" material="terrain_mat"/>
    </body>
    <body name="obstacle_3" pos="5 -5 1.5">
      <geom type="sphere" size="0.3" material="terrain_mat"/>
    </body>
     -->
    
  </worldbody>
</mujoco>
